{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earth.local/contracts/strategy_packet.v1.schema.json",
  "title": "Strategy Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "strategy",
    "recommendations",
    "recommendation_to_planner_mapping_artifact",
    "constraints",
    "kpi_targets",
    "blocker_handling_policy_artifact",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": "strategy-packet.v1"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "run_id", "event_id"],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^prj\\.[a-z0-9][a-z0-9-]{1,95}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^run\\.[a-z0-9][a-z0-9-]{1,95}$"
        },
        "event_id": {
          "type": "string",
          "pattern": "^event\\.[a-z0-9][a-z0-9-]{1,95}$"
        },
        "era_id": {
          "type": "string",
          "pattern": "^era\\.[a-z0-9][a-z0-9-]{1,95}$"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^plan\\.[a-z0-9][a-z0-9-]{1,95}$"
        }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision_id", "summary"],
      "properties": {
        "revision_id": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "link_map_ref": {"type": "string"}
      }
    },
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recommendation_id",
          "priority",
          "summary",
          "rationale",
          "expected_impact",
          "risk_level"
        ],
        "properties": {
          "recommendation_id": {
            "type": "string",
            "pattern": "^rec\\.[a-z0-9][a-z0-9-]{1,95}$"
          },
          "priority": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "summary": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "expected_impact": {"type": "string", "minLength": 1},
          "risk_level": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          }
        }
      }
    },
    "recommendation_to_planner_mapping_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommendation_to_task_intent_mappings",
        "recommendation_ids",
        "planner_task_intent_handles"
      ],
      "properties": {
        "recommendation_to_task_intent_mappings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mapping_id",
              "recommendation_id",
              "planner_task_intent_handle",
              "planner_task_intent_summary",
              "planner_lane",
              "sequence_hint",
              "traceability_refs",
              "downstream_audit_trail"
            ],
            "properties": {
              "mapping_id": {
                "type": "string",
                "pattern": "^rtp\\.[a-f0-9]{12}$"
              },
              "recommendation_id": {
                "type": "string",
                "pattern": "^rec\\.[a-z0-9][a-z0-9-]{1,95}$"
              },
              "planner_task_intent_handle": {
                "type": "string",
                "pattern": "^intent\\.[a-z0-9][a-z0-9-]{1,95}$"
              },
              "planner_task_intent_summary": {
                "type": "string",
                "minLength": 1
              },
              "planner_lane": {
                "type": "string",
                "minLength": 1
              },
              "sequence_hint": {
                "type": "integer",
                "minimum": 1
              },
              "traceability_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "downstream_audit_trail": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source_call_trace_refs",
                  "source_evidence_refs",
                  "source_packet_refs",
                  "emitted_at_utc",
                  "emitted_by_requirement_id"
                ],
                "properties": {
                  "source_call_trace_refs": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "source_evidence_refs": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "source_packet_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "emitted_at_utc": {
                    "type": "string",
                    "minLength": 1
                  },
                  "emitted_by_requirement_id": {
                    "const": "REQ-054"
                  }
                }
              }
            }
          }
        },
        "recommendation_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^rec\\.[a-z0-9][a-z0-9-]{1,95}$"
          }
        },
        "planner_task_intent_handles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^intent\\.[a-z0-9][a-z0-9-]{1,95}$"
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard", "soft"],
      "properties": {
        "hard": {
          "type": "array",
          "items": {"type": "string"}
        },
        "soft": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "kpi_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "direction"],
        "properties": {
          "metric": {"type": "string", "minLength": 1},
          "direction": {
            "type": "string",
            "enum": ["increase", "decrease", "maintain"]
          },
          "target": {"type": "string"}
        }
      }
    },
    "blocker_handling_policy_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policies"],
      "properties": {
        "policies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "policy_id",
              "blocker_code",
              "escalation_trigger",
              "owner_hints",
              "fallback_paths"
            ],
            "properties": {
              "policy_id": {"type": "string", "minLength": 1},
              "blocker_code": {"type": "string", "minLength": 1},
              "escalation_trigger": {
                "type": "object",
                "additionalProperties": false,
                "required": ["trigger_type", "threshold", "window"],
                "properties": {
                  "trigger_type": {
                    "type": "string",
                    "enum": ["attempts_exhausted", "dependency_timeout", "guardrail_violation"]
                  },
                  "threshold": {"type": "integer", "minimum": 1},
                  "window": {"type": "string", "enum": ["attempts", "cycles", "minutes"]}
                }
              },
              "owner_hints": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              },
              "fallback_paths": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              },
              "project_id": {"type": "string"},
              "evidence_refs": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "tool"],
      "properties": {
        "repo": {"type": "string", "minLength": 1},
        "tool": {"type": "string", "minLength": 1}
      }
    }
  }
}
