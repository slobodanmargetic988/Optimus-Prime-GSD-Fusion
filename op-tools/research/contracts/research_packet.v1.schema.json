{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earth.local/contracts/research_packet.v1.schema.json",
  "title": "Research Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "context",
    "topics",
    "open_questions",
    "evidence_refs",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": "research-packet.v1"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "run_id", "event_id"],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^prj\\.[a-z0-9][a-z0-9-]{1,95}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^run\\.[a-z0-9][a-z0-9-]{1,95}$"
        },
        "event_id": {
          "type": "string",
          "pattern": "^event\\.[a-z0-9][a-z0-9-]{1,95}$"
        },
        "era_id": {
          "type": "string",
          "pattern": "^era\\.[a-z0-9][a-z0-9-]{1,95}$"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^plan\\.[a-z0-9][a-z0-9-]{1,95}$"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mission_refs", "scope_refs"],
      "properties": {
        "mission_refs": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "scope_refs": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "strategy_ref": {
          "type": "string"
        }
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic_id",
          "title",
          "recommendation_summary",
          "tradeoffs",
          "risk_level"
        ],
        "properties": {
          "topic_id": {
            "type": "string",
            "pattern": "^topic\\.[a-z0-9][a-z0-9-]{1,95}$"
          },
          "title": {"type": "string", "minLength": 1},
          "recommendation_summary": {"type": "string", "minLength": 1},
          "tradeoffs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "minItems": 1
          },
          "risk_level": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "uri"],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^artifact\\.[a-z0-9][a-z0-9-]{1,95}$"
          },
          "kind": {"type": "string", "minLength": 1},
          "uri": {"type": "string", "minLength": 1},
          "notes": {"type": "string"}
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "tool"],
      "properties": {
        "repo": {"type": "string", "minLength": 1},
        "tool": {"type": "string", "minLength": 1}
      }
    }
  }
}
