{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earth.local/contracts/strategy_packet.v1.schema.json",
  "title": "Strategy Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "strategy",
    "recommendations",
    "constraints",
    "kpi_targets",
    "assumptions",
    "kpi_target_artifact",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": "strategy-packet.v1"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "run_id", "event_id"],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^prj\\.[a-z0-9][a-z0-9-]{1,95}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^run\\.[a-z0-9][a-z0-9-]{1,95}$"
        },
        "event_id": {
          "type": "string",
          "pattern": "^event\\.[a-z0-9][a-z0-9-]{1,95}$"
        },
        "era_id": {
          "type": "string",
          "pattern": "^era\\.[a-z0-9][a-z0-9-]{1,95}$"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^plan\\.[a-z0-9][a-z0-9-]{1,95}$"
        }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision_id", "summary"],
      "properties": {
        "revision_id": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "link_map_ref": {"type": "string"}
      }
    },
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recommendation_id",
          "priority",
          "summary",
          "rationale",
          "expected_impact",
          "risk_level"
        ],
        "properties": {
          "recommendation_id": {
            "type": "string",
            "pattern": "^rec\\.[a-z0-9][a-z0-9-]{1,95}$"
          },
          "priority": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "summary": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1},
          "expected_impact": {"type": "string", "minLength": 1},
          "risk_level": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard", "soft"],
      "properties": {
        "hard": {
          "type": "array",
          "items": {"type": "string"}
        },
        "soft": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "kpi_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "direction"],
        "properties": {
          "metric": {"type": "string", "minLength": 1},
          "direction": {
            "type": "string",
            "enum": ["increase", "decrease", "maintain"]
          },
          "target": {"type": "string"}
        }
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assumption_id", "statement"],
        "properties": {
          "assumption_id": {
            "type": "string",
            "pattern": "^assumption\\.[a-z0-9][a-z0-9-]{1,95}$"
          },
          "statement": {"type": "string", "minLength": 1}
        }
      }
    },
    "kpi_target_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kpi_targets", "totals"],
      "properties": {
        "kpi_targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target_id",
              "metric_name",
              "expected_direction",
              "baseline_reference",
              "confidence_level",
              "originating_recommendation_ids",
              "assumption_ids"
            ],
            "properties": {
              "target_id": {
                "type": "string",
                "pattern": "^kpi\\.[a-z0-9][a-z0-9-]{1,95}$"
              },
              "metric_name": {"type": "string", "minLength": 1},
              "expected_direction": {
                "type": "string",
                "enum": ["increase", "decrease", "maintain"]
              },
              "baseline_reference": {"type": "string", "minLength": 1},
              "confidence_level": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "originating_recommendation_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^rec\\.[a-z0-9][a-z0-9-]{1,95}$"
                }
              },
              "assumption_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^assumption\\.[a-z0-9][a-z0-9-]{1,95}$"
                }
              }
            }
          }
        },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kpi_targets",
            "unique_recommendations_linked",
            "unique_assumptions_linked"
          ],
          "properties": {
            "kpi_targets": {"type": "integer", "minimum": 1},
            "unique_recommendations_linked": {"type": "integer", "minimum": 1},
            "unique_assumptions_linked": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "tool"],
      "properties": {
        "repo": {"type": "string", "minLength": 1},
        "tool": {"type": "string", "minLength": 1}
      }
    }
  }
}
