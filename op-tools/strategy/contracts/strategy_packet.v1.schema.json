{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earth.local/contracts/strategy_packet.v1.schema.json",
  "title": "Strategy Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "strategy",
    "recommendations",
    "constraints",
    "kpi_targets",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": "strategy-packet.v1"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "run_id",
        "event_id"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^prj\\.[a-z0-9][a-z0-9-]{1,95}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^run\\.[a-z0-9][a-z0-9-]{1,95}$"
        },
        "event_id": {
          "type": "string",
          "pattern": "^event\\.[a-z0-9][a-z0-9-]{1,95}$"
        },
        "era_id": {
          "type": "string",
          "pattern": "^era\\.[a-z0-9][a-z0-9-]{1,95}$"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^plan\\.[a-z0-9][a-z0-9-]{1,95}$"
        }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_id",
        "summary"
      ],
      "properties": {
        "revision_id": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "link_map_ref": {
          "type": "string"
        }
      }
    },
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recommendation_id",
          "priority",
          "summary",
          "rationale",
          "expected_impact",
          "risk_level"
        ],
        "properties": {
          "recommendation_id": {
            "type": "string",
            "pattern": "^rec\\.[a-z0-9][a-z0-9-]{1,95}$"
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "expected_impact": {
            "type": "string",
            "minLength": 1
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hard_constraints",
        "soft_constraints",
        "speculative_constraints",
        "planner_policy"
      ],
      "properties": {
        "hard_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint_row"
          }
        },
        "soft_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint_row"
          }
        },
        "speculative_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint_row"
          }
        },
        "planner_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hard_constraint_ids",
            "soft_constraint_ids",
            "speculative_constraint_ids",
            "mandatory_guardrail_ids",
            "optional_guidance_ids"
          ],
          "properties": {
            "hard_constraint_ids": {
              "$ref": "#/$defs/constraint_id_list"
            },
            "soft_constraint_ids": {
              "$ref": "#/$defs/constraint_id_list"
            },
            "speculative_constraint_ids": {
              "$ref": "#/$defs/constraint_id_list"
            },
            "mandatory_guardrail_ids": {
              "$ref": "#/$defs/constraint_id_list"
            },
            "optional_guidance_ids": {
              "$ref": "#/$defs/constraint_id_list"
            }
          }
        }
      }
    },
    "kpi_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "direction"
        ],
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "type": "string",
            "enum": [
              "increase",
              "decrease",
              "maintain"
            ]
          },
          "target": {
            "type": "string"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "tool"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "constraint_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,95}$"
    },
    "constraint_id_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/constraint_id"
      }
    },
    "ref_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraint_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "statement",
        "classification",
        "rationale",
        "evidence_refs",
        "source_refs",
        "policy_role"
      ],
      "properties": {
        "constraint_id": {
          "$ref": "#/$defs/constraint_id"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "enum": [
            "hard",
            "soft",
            "speculative"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "$ref": "#/$defs/ref_list"
        },
        "source_refs": {
          "$ref": "#/$defs/ref_list"
        },
        "policy_role": {
          "type": "string",
          "enum": [
            "mandatory_guardrail",
            "optional_guidance"
          ]
        }
      }
    }
  }
}
