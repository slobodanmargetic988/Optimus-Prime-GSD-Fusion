{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://earth.local/contracts/strategy_packet.v1.schema.json",
  "title": "Strategy Packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "strategy",
    "recommendations",
    "recommendation_mapping",
    "constraints",
    "kpi_targets",
    "source",
    "gate_policy",
    "strategy_quality_report"
  ],
  "properties": {
    "schema_version": {
      "const": "strategy-packet.v1"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "run_id",
        "event_id"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^prj\\.[a-z0-9][a-z0-9-]{1,95}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^run\\.[a-z0-9][a-z0-9-]{1,95}$"
        },
        "event_id": {
          "type": "string",
          "pattern": "^event\\.[a-z0-9][a-z0-9-]{1,95}$"
        },
        "era_id": {
          "type": "string",
          "pattern": "^era\\.[a-z0-9][a-z0-9-]{1,95}$"
        },
        "plan_id": {
          "type": "string",
          "pattern": "^plan\\.[a-z0-9][a-z0-9-]{1,95}$"
        }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_id",
        "summary"
      ],
      "properties": {
        "revision_id": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "link_map_ref": {
          "type": "string"
        }
      }
    },
    "recommendations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recommendation_id",
          "priority",
          "summary",
          "rationale",
          "expected_impact",
          "risk_level"
        ],
        "properties": {
          "recommendation_id": {
            "type": "string",
            "pattern": "^rec\\.[a-z0-9][a-z0-9-]{1,95}$"
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "expected_impact": {
            "type": "string",
            "minLength": 1
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          }
        }
      }
    },
    "recommendation_mapping": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recommendation_id", "op_plan_ref", "op_initialize_ref"],
        "properties": {
          "recommendation_id": {
            "type": "string",
            "pattern": "^rec\\.[a-z0-9][a-z0-9-]{1,95}$"
          },
          "op_plan_ref": {
            "type": "string",
            "minLength": 1
          },
          "op_initialize_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hard_constraints",
        "soft_constraints",
        "speculative_constraints",
        "planner_policy"
      ],
      "properties": {
        "hard_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint_row"
          }
        },
        "soft_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint_row"
          }
        },
        "speculative_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint_row"
          }
        },
        "planner_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hard_constraint_ids",
            "soft_constraint_ids",
            "speculative_constraint_ids",
            "mandatory_guardrail_ids",
            "optional_guidance_ids"
          ],
          "properties": {
            "hard_constraint_ids": {
              "$ref": "#/$defs/constraint_id_list"
            },
            "soft_constraint_ids": {
              "$ref": "#/$defs/constraint_id_list"
            },
            "speculative_constraint_ids": {
              "$ref": "#/$defs/constraint_id_list"
            },
            "mandatory_guardrail_ids": {
              "$ref": "#/$defs/constraint_id_list"
            },
            "optional_guidance_ids": {
              "$ref": "#/$defs/constraint_id_list"
            }
          }
        }
      }
    },
    "kpi_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "direction"
        ],
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "type": "string",
            "enum": [
              "increase",
              "decrease",
              "maintain"
            ]
          },
          "target": {
            "type": "string"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "tool"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "constraint_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,95}$"
    },
    "constraint_id_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/constraint_id"
      }
    },
    "ref_list": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraint_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "statement",
        "classification",
        "rationale",
        "evidence_refs",
        "source_refs",
        "policy_role"
      ],
      "properties": {
        "constraint_id": {
          "$ref": "#/$defs/constraint_id"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "enum": [
            "hard",
            "soft",
            "speculative"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "$ref": "#/$defs/ref_list"
        },
        "source_refs": {
          "$ref": "#/$defs/ref_list"
        },
        "policy_role": {
          "type": "string",
          "enum": [
            "mandatory_guardrail",
            "optional_guidance"
          ]
        }
      }
    },
    "gate_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_citation_coverage_ratio",
        "max_unresolved_contradictions",
        "min_high_confidence_ratio"
      ],
      "properties": {
        "min_citation_coverage_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_unresolved_contradictions": {
          "type": "integer",
          "minimum": 0
        },
        "min_high_confidence_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "strategy_quality_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation_coverage",
        "contradiction_status",
        "confidence_distribution",
        "gate_verdicts"
      ],
      "properties": {
        "citation_coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cited_claims",
            "uncited_claims",
            "total_claims",
            "coverage_ratio"
          ],
          "properties": {
            "cited_claims": {
              "type": "integer",
              "minimum": 0
            },
            "uncited_claims": {
              "type": "integer",
              "minimum": 0
            },
            "total_claims": {
              "type": "integer",
              "minimum": 1
            },
            "coverage_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "contradiction_status": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "has_unresolved_contradictions",
            "unresolved_contradiction_count",
            "unresolved_contradiction_ids"
          ],
          "properties": {
            "has_unresolved_contradictions": {
              "type": "boolean"
            },
            "unresolved_contradiction_count": {
              "type": "integer",
              "minimum": 0
            },
            "unresolved_contradiction_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "confidence_distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "high",
            "medium",
            "low",
            "total",
            "high_ratio",
            "medium_ratio",
            "low_ratio"
          ],
          "properties": {
            "high": {
              "type": "integer",
              "minimum": 0
            },
            "medium": {
              "type": "integer",
              "minimum": 0
            },
            "low": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 1
            },
            "high_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "medium_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "low_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "gate_verdicts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "citation_coverage_pass",
            "contradiction_pass",
            "confidence_distribution_pass",
            "overall_pass",
            "failed_gate_ids"
          ],
          "properties": {
            "citation_coverage_pass": {
              "type": "boolean"
            },
            "contradiction_pass": {
              "type": "boolean"
            },
            "confidence_distribution_pass": {
              "type": "boolean"
            },
            "overall_pass": {
              "type": "boolean"
            },
            "failed_gate_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "citation_coverage",
                  "contradiction_status",
                  "confidence_distribution"
                ]
              }
            }
          }
        }
      }
    }
  }
}
